# ============================================================================
# UtsavaVaibhavam AI — Environment Configuration Template
# Copy this file to `.env` for local development:
#   cp .env.example .env
# Never commit your actual `.env` file or real API keys to version control.
# ============================================================================

# GEMINI_API_KEY: Required for server-side Google Gemini API endpoints (/api/agent/*).
# Obtain an API key from Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: Public or local URL where the application is served.
APP_URL="http://localhost:3000"

# PORT: Express + Vite server port (defaults to 3000).
PORT="3000"
